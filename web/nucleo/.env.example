APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ingecon
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo saliente. En el hosting cPanel el envio lo hace el sendmail local del
# propio servidor (Diagrama de Componentes: SendmailAdapter «Boundary»), por eso
# no hay credenciales SMTP que configurar ni que compartir.
# En desarrollo conviene MAIL_MAILER=log, que escribe el correo en el log en vez
# de enviarlo.
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_FROM_ADDRESS="no-reply@ingeconltda.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Solo si alguna vez se vuelve a un envio por SMTP externo:
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# RF10 / CU 10.1 - URL de la documentacion tecnica de Conectores Metalicos.
# El enlace del encabezado apunta aca. El valor real lo tiene que confirmar
# Ingecon: hoy el seeder siembra https://www.simpsonstrongtie.cl/ como ejemplo,
# que es la portada de un fabricante y no una ficha tecnica.
# La URL vive en la tabla `contenidos` (seccion "documentacion") para poder
# cambiarla sin tocar el codigo; esta variable solo define el valor inicial.
DOCS_CONECTORES_URL=
